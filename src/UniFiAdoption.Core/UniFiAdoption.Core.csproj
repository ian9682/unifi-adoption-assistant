<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine: discovery, inventory, checks, SSH, device commands, batches. No UI.
       Windows-only pieces (ARP sweep, DPAPI) are only called on Windows. -->
  <PropertyGroup>
    <!-- net48 is what ships (built into Windows 10/11, so the app stays small).
         net10.0 is built too so the same code is tested on modern .NET. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>UniFiAdoption.Core</RootNamespace>
  </PropertyGroup>

  <!-- Normal builds restore SSH.NET from nuget.org. -->
  <ItemGroup Condition="'$(LocalDependencyDir)' == ''">
    <PackageReference Include="SSH.NET" Version="$(SshNetVersion)" />
  </ItemGroup>

  <!-- Offline verification builds only: reference locally built copies of the same libraries.
       Usage: dotnet build -p:LocalDependencyDir=/path/to/dlls -->
  <ItemGroup Condition="'$(LocalDependencyDir)' != ''">
    <Reference Include="Renci.SshNet"><HintPath>$(LocalDependencyDir)/Renci.SshNet.dll</HintPath></Reference>
    <Reference Include="BouncyCastle.Cryptography"><HintPath>$(LocalDependencyDir)/BouncyCastle.Cryptography.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(LocalDependencyDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions"><HintPath>$(LocalDependencyDir)/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UniFiAdoption.Tests" />
  </ItemGroup>

</Project>
