<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Product>UniFi Adoption Assistant</Product>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- SSH.NET is the only third-party runtime dependency (MIT). It brings BouncyCastle.Cryptography (MIT)
         and Microsoft.Extensions.Logging.Abstractions (MIT) with it. -->
    <SshNetVersion>2026.0.0</SshNetVersion>
  </PropertyGroup>
</Project>
